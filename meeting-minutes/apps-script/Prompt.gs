/**
 * Gemini に渡す文字起こしの指示文。
 * 後で Claude が「空気感・キラーフレーズ・認識のズレ・合意の確度」まで整理できるよう、
 * 要約せず、話し方や間、画面の内容も含めて書き起こしてもらう。
 */

function hms_(sec) {
  const s = Math.max(0, Math.floor(sec));
  const pad = function (n) { return ('0' + n).slice(-2); };
  return pad(Math.floor(s / 3600)) + ':' + pad(Math.floor(s / 60) % 60) + ':' + pad(s % 60);
}

function transcriptPrompt_(entry, seg, index, total) {
  const range = hms_(seg.start) + '〜' + hms_(seg.end);
  const isVideo = entry.kind === '動画';
  const lines = [
    'あなたは日本語のビジネス会議の書き起こし担当です。添付の' + (isVideo ? '録画' : '録音') + 'を正確に書き起こしてください。',
    'この書き起こしは、後で別の担当者が議事録を作るための元資料です。要約せず、発言をできるだけそのまま残してください。',
    '',
    '## 対象範囲',
    '- 全' + total + '区間のうち第' + index + '区間。元ファイル先頭からの時刻で ' + range + ' の範囲だけを書き起こす。',
    isVideo
      ? '- 添付は元ファイルのこの範囲を切り出したもの。タイムスタンプは切り出しの先頭ではなく、元ファイル先頭からの時刻（' + hms_(seg.start) + ' に切り出し位置の秒数を足した値）で書く。'
      : '- 範囲の外は書かない。',
    index > 1 ? '- 先頭の約30秒は前の区間と重なっている。重なり部分も省略せずに書く（後でつなぎ合わせる）。' : '',
    '- 範囲内に音声が無い場合は「（この区間に音声はありません）」とだけ書く。',
    '',
    '## 出力の形式',
    '最初に「■話者メモ」として、この区間に登場する話者を1行ずつ書く。',
    '  形式: 話者名 ｜ 所属・役割（分かれば）｜ 名前を判断した根拠（自己紹介、呼びかけられた名前など）｜ 声や話し方の特徴',
    '  名前が分からない話者は「話者A」「話者B」…とし、特徴を詳しく書く（別の区間と同一人物か照合するため）。',
    '次に「■本文」として、発言を次の形で1発言1行で書く。',
    '  [HH:MM:SS] 話者名: 発言内容',
    '',
    '## 書き起こしのルール',
    '- 要約・言い換え・補足をしない。意味のない「えー」「あのー」だけは省いてよいが、言い淀みや迷いが分かる箇所は残す。',
    '- 話し方や場の様子を〔 〕で発言の中や行の後ろに書き添える。例: 〔笑い〕〔沈黙 約5秒〕〔語気が強まる〕〔声が小さくなる〕〔ため息〕〔歯切れが悪い〕〔複数人が同時に話す〕〔一同うなずく様子〕',
    '- 聞き取れない箇所は〔聞き取れず〕、自信がない語は〔聞き取り不確か: ○○?〕とする。推測で埋めない。',
    '- 数字・金額・日付・固有名詞（社名、人名、製品名、制度名）は特に正確に書く。表記が分からない固有名詞はカタカナで書く。',
    '- 比喩や印象的な言い回しは、言葉どおりに残す。',
    isVideo ? '- 画面共有やスライドが映ったら、その時刻に「[HH:MM:SS] 〔画面: …〕」の行を入れ、資料のタイトル、見出し、数値、表やグラフの要点、画面上の文字を詳しく書く。画面が切り替わるたびに書く。' : '',
    isVideo ? '- 参加者の映像から分かる様子（うなずき、困惑した表情など）も、分かる範囲で〔 〕に書く。' : '',
    '- 出典番号や引用タグ（[1] など）は書かない。前置きやまとめの文も書かない。',
    '',
    '## 参考情報',
    '- ファイル名: ' + entry.fileName,
    '- 録音日時（ファイル名から推定）: ' + (entry.nameDate || '不明'),
  ];
  return lines.filter(function (l) { return l !== ''; }).join('\n')
    .replace(/\n## /g, '\n\n## ');
}
